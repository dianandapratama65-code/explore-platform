# ============================================================
# Explore — Konfigurasi Environment
# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN meng commit .env ke version control.
# ============================================================

# --- Server ---
PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development

# --- PostgreSQL (lokal / embedded) ---
# Default memakai PostgreSQL embedded (tanpa instalasi sistem).
PG_HOST=127.0.0.1
PG_PORT=5433
PG_DATABASE=explore
PG_USER=explore
PG_PASSWORD=ganti-dengan-password-superuser
PG_DATA_DIR=var/pgdata

# Role aplikasi (dipakai koneksi runtime agar RLS aktif;
# role ini BUKAN superuser sehingga Row Level Security ditegakkan)
PG_APP_USER=explore_app
PG_APP_PASSWORD=ganti-dengan-password-app

# --- Autentikasi ---
# Ganti dengan secret acak panjang di produksi (mis. openssl rand -hex 64)
JWT_SECRET=ganti-dengan-secret-acak-panjang
JWT_EXPIRES_IN=15m
SESSION_DAYS=7
COOKIE_SECURE=false

# --- Email ---
# Kosongkan = mode pengembangan: email ditulis ke var/mail/*.eml
# Isi dengan SMTP URL untuk produksi, mis: smtp://user:pass@smtp.example.com:587
SMTP_URL=
MAIL_FROM="Explore <no-reply@explore.local>"

# --- Integrasi eksternal (opsional, boleh dikosongkan) ---
# Google Maps JavaScript API key. Kosongkan = peta memakai OpenStreetMap
# (Leaflet) + deep-link Google Maps seperti prototipe awal.
GOOGLE_MAPS_API_KEY=

# --- Keamanan ---
# Rate limit: permintaan per menit untuk endpoint auth sensitif
RATE_LIMIT_AUTH=10
RATE_LIMIT_API=120
